# Upload only application/build sources; never local credentials or research data.
*
!Dockerfile
!.dockerignore
!infra/
infra/*
!infra/cloudbuild.yaml
!infra/env.dev.yaml
!infra/verify_deployment.py
!backend/
backend/*
!backend/requirements.txt
!backend/app/
!backend/app/**
!backend/tests/
!backend/tests/**
!web/
!web/**
**/node_modules/
**/web_dist/
**/dist/
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/.venv/
**/data/
**/.pytest_cache/
