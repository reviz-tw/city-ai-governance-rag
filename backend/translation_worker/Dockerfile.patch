# Repair the already-built immutable worker without downloading weights again.
FROM asia-east1-docker.pkg.dev/tdf-ocf/haystack-dev/city-translategemma@sha256:67548aef32b1c8034202ea7f575cfe3aa7a5df942fd130b82139943abf4e1551
RUN ln -s /usr/lib/ollama /usr/local/lib/ollama && LD_LIBRARY_PATH=/usr/local/lib/ollama /usr/local/lib/ollama/llama-server --version
COPY backend/app /app/app
COPY backend/translation_worker/entrypoint.sh /app/translation-entrypoint.sh
RUN chmod +x /app/translation-entrypoint.sh
CMD ["--max-seconds", "720"]
